# Porta (Railway injeta automaticamente, mas defina default)
PORT=3000

# Chave de autenticação (gere uma string longa aleatória, ex: openssl rand -hex 32)
FFMPEG_API_KEY=your_api_key_here

# Concorrência máxima por instância (default 3)
MAX_CONCURRENT_JOBS=3

# Cloudflare R2 (mesmas credenciais dos outros servidores)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET=your_bucket_name
